<Project>
  <!-- dotnet publish src/RipOff.Game -p:PublishProfile=win-x64   (tools/publish.ps1 wraps this and zips the result)
       Self-contained win-x64 folder: RipOff.exe, the .NET runtime, MonoGame's SDL2/OpenAL natives,
       Steamworks.NET.dll, steam_api64.dll and steam_appid.txt (480) side by side. Not single-file, so the
       native libraries stay next to the exe where Steam and SDL look for them. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
