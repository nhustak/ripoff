<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RipOff</AssemblyName>
    <RootNamespace>RipOff.Game</RootNamespace>
  </PropertyGroup>
  <!-- Scaffolded with the MonoGame.Templates.CSharp 3.8.6 "mgdesktopgl" template; MonoGame pinned to 3.8.6.
       No content pipeline: everything is drawn as lines from RipOff.Core's shape data. -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RipOff.Core\RipOff.Core.csproj" />
  </ItemGroup>
</Project>
