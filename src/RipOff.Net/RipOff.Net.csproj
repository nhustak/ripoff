<Project Sdk="Microsoft.NET.Sdk">
  <!-- Online play without any platform dependency: transport abstraction, input-sync lockstep, an in-memory
       loopback transport (tests) and a LiteNetLib transport (direct IP / LAN). Steam lives in RipOff.Game. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>RipOff.Net</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- LiteNetLib 2.1.4: latest NuGet release (api.nuget.org flat container, checked 2026-10-16). -->
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RipOff.Core\RipOff.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RipOff.Net.Tests" />
    <InternalsVisibleTo Include="RipOff.Game.Tests" />
  </ItemGroup>
</Project>
